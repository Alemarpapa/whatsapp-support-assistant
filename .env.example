# Copy to .env and fill in. Never commit .env.

# App Secret of your Meta app: used to verify X-Hub-Signature-256 on incoming webhooks.
WHATSAPP_APP_SECRET=replace-with-your-app-secret
# Any string you choose; you type the same value in the Meta App Dashboard webhook settings.
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-string
# Business phone number ID (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# "mock" prints replies to the terminal and needs no Meta account. "cloud" calls the Graph API.
OUTBOUND_MODE=mock
# Only needed when OUTBOUND_MODE=cloud.
WHATSAPP_ACCESS_TOKEN=
GRAPH_API_VERSION=v27.0

PORT=3000
DB_PATH=data/assistant.sqlite
